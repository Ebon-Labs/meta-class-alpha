    - target: {fileID: 5898206938597652802, guid: f1a0c12480c0618739f47754f11f6b80, type: 3}
      propertyPath: body
      value: "Saturno tamb\xE9m \xE9 um gigante de g\xE1s e \xE9 famoso pelos an\xE9is,
        feitos de peda\xE7os de gelo e rocha. \xC9 t\xE3o leve para o seu tamanho
        que, se existisse uma banheira grande o bastante, ele flutuaria."
      objectReference: {fileID: 0}
